#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
python3 scripts/ci/sync-woodpecker-validation.py --check
python3 -m unittest discover -s scripts/ci -p test_woodpecker_validation_profile.py
go_root=$(mise where go@1.25.13)
export GOROOT="$go_root"
export PATH="$go_root/bin:$PATH"
make check
make lint check-docs-crosslinks check-ci-path-filters check-packaging-versions check-release-build check-verify-release
python3 scripts/ci/check-pages-site.py --site site --architecture docs/architecture/appicon.html --architecture-source docs/architecture/appicon.architecture.json
actionlint
zizmor --offline --min-severity medium --min-confidence medium .github
