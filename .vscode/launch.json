{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI help",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/appicon",
      "cwd": "${workspaceFolder}",
      "args": [
        "--help"
      ]
    },
    {
      "name": "Debug current package tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "cwd": "${fileDirname}"
    }
  ]
}
